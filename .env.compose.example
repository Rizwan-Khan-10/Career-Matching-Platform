# Copy to .env.compose (it is gitignored) and fill in the real values:
#   docker compose --env-file .env.compose up --build
# Placeholders only: never commit real secrets.

# ---- URL the browser uses (nginx). Baked into the web build: after changing it run `up --build` again.
# If port 80 is busy set HTTP_PORT=8080 and PUBLIC_URL=http://localhost:8080
PUBLIC_URL=http://localhost
HTTP_PORT=80

# ---- PostgreSQL (pgvector image). Use a URL-safe password (letters and digits): it is placed inside DATABASE_URL.
POSTGRES_USER=career
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=career_matching

EXTERNAL_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# ---- Shared secrets (the same value reaches every service). Make them long and random.
JWT_SECRET=change-me-long-random-secret
JWT_REFRESH_SECRET=change-me-another-long-random-secret
INTERNAL_API_KEY=change-me-internal-key

TWO_FACTOR_ENCRYPTION_KEY=change-me-run-openssl-rand-hex-32
TWO_FACTOR_ISSUER=CareerMatch

GOOGLE_CLIENT_ID=

# ---- Admin created at first start (SEED_ADMIN_ON_BOOT=true). Password: at least 12 characters. Change it after the first login.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password

# ---- Cloudinary (resume and job files)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ---- Groq (LLM for the agents)
GROQ_API_KEY=shared-fallback-key
RESUME_PARSER_GROQ_API_KEY=
JD_EXTRACTOR_GROQ_API_KEY=
FEEDBACK_GROQ_API_KEY=
CHATBOT_GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_REASONING_EFFORT=low

# ---- Email. Local default: Gmail with an app password; EMAIL_DEV_REDIRECT_TO sends ALL mail to one inbox.
# Without a working transport the in-app notifications still work, only emails fail.
EMAIL_PROVIDER=gmail
EMAIL_FROM=your-address@example.com
EMAIL_DEV_REDIRECT_TO=your-address@example.com
GMAIL_USER=your-address@example.com
GMAIL_APP_PASSWORD=your-gmail-app-password
GMAIL_FROM_NAME=Career Matching
# RESEND_API_KEY=

# ---- Optional
LOG_LEVEL=info
AGENT_LOG_LEVEL=INFO
CHAT_RATE_PER_MINUTE=10
CHAT_RATE_PER_DAY=200
E2E_WAIT_MS=120000
E2E_QUIET_MS=10000

ELIGIBILITY_THRESHOLD=0.40