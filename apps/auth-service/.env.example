PORT=3001
NODE_ENV=development
DATABASE_URL=postgresql://user:password@localhost:5432/career_matching
REDIS_URL=redis://localhost:6379

# Same value in every service
JWT_SECRET=change-me-same-value-in-every-service
JWT_REFRESH_SECRET=change-me-auth-only
INTERNAL_API_KEY=change-me-same-value-in-every-service

USER_SERVICE_URL=http://localhost:3002

# First admin (seed). Password: at least 12 characters. Change it after the first login.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-12-plus-chars
# true = create the admin automatically when the service starts (Docker / CI)
SEED_ADMIN_ON_BOOT=false

# db:reset refuses to run when NODE_ENV=production unless this is true
# ALLOW_DB_RESET=false

# Behind nginx set 1 so the login lock sees the real client IP. Leave 0 when clients hit the service directly.
TRUST_PROXY_HOPS=0

# ops
ENABLE_DOCS=false
LOG_LEVEL=info

# Max sign-ups per IP per hour. Raise it if a whole college shares one public IP.
SIGNUP_RATE_MAX=20