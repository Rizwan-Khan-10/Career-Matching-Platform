generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["auth_service"]
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         Role
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  twoFactorEnabled Boolean        @default(false)
  twoFactorSecret  String? // AES-256-GCM encrypted, never plain text
  recoveryCodes    RecoveryCode[]

  @@schema("auth_service")
}

model RecoveryCode {
  id       String    @id @default(uuid())
  userId   String
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash String // bcrypt hash; the plain code is shown to the user only once
  usedAt   DateTime?

  @@index([userId])
  @@schema("auth_service")
}

// Admin-controlled settings. Keys: registrationMode, allowedDomains,
// companyApprovalRequired, jobApprovalRequired (contract §4.5).
// A missing key means "use the default" (see src/settings/settings.ts).
model SystemSetting {
  key   String @id
  value Json

  @@schema("auth_service")
}

enum Role {
  ADMIN
  COMPANY
  APPLICANT

  @@schema("auth_service")
}