PORT=3008
DATABASE_URL=postgresql://user:password@localhost:5432/career_matching
REDIS_URL=redis://localhost:6379

# same value in EVERY service (tokens are verified here, issued by auth-service)
JWT_SECRET=change-me-same-value-in-every-service

# where this service sends its calls
CHATBOT_AGENT_URL=http://localhost:8005
MATCHING_SERVICE_URL=http://localhost:3005
JOB_SERVICE_URL=http://localhost:3004

# sent as header x-internal-key on calls to other services' /internal/* routes; must equal the value in those services
INTERNAL_API_KEY=change-me

# messages one user may send to the assistant (counted in Redis, shared by all instances)
CHAT_RATE_PER_MINUTE=10
CHAT_RATE_PER_DAY=200

# ops
ENABLE_DOCS=false
LOG_LEVEL=info

# only read by `pnpm db:reset` (it refuses to run with NODE_ENV=production unless ALLOW_DB_RESET=true)
# NODE_ENV=development
# ALLOW_DB_RESET=false

# browsers allowed to call this API (comma separated). Empty = any origin (local development only)
WEB_URL=http://localhost:3000
