PORT=3004
DATABASE_URL=postgresql://user:password@localhost:5432/career_matching
REDIS_URL=redis://localhost:6379

# Same value in every service
JWT_SECRET=change-me-same-value-in-every-service
INTERNAL_API_KEY=change-me-same-value-in-every-service

# user-service: company approval check (GET /internal/companies/:id/status). Unreachable = uploads answer 503.
USER_SERVICE_URL=http://localhost:3002
# auth-service: GET /internal/settings -> jobApprovalRequired (cached 60 s). Unreachable = uploads answer 503.
AUTH_SERVICE_URL=http://localhost:3001

CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ops
ENABLE_DOCS=false
LOG_LEVEL=info

# only read by `pnpm db:reset` (it refuses to run with NODE_ENV=production unless ALLOW_DB_RESET=true)
# NODE_ENV=development
# ALLOW_DB_RESET=false

# browsers allowed to call this API (comma separated). Empty = any origin (local development only)
WEB_URL=http://localhost:3000
