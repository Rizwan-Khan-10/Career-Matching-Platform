generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas = ["jobs_service"]
}

model JobPosting {
  id           String    @id @default(uuid())
  companyId    String
  fileUrl      String
  status       String    @default("pending") // pending | extracted | failed
  errorMessage String?
  stoppedAt    DateTime? // set = company stopped this job: no scanning of the document, no matching
  approvalStatus String  @default("approved") // approved | pending | rejected (pending/rejected: not scanned, not matched). Old rows stay approved
  approvalNote   String?  // the admin's note on the decision
  createdAt    DateTime  @default(now())
  roles        JobRole[]

  @@schema("jobs_service")
}

model JobRole {
  id           String     @id @default(uuid())
  jobPostingId String
  jobPosting   JobPosting @relation(fields: [jobPostingId], references: [id])
  title        String
  requirements Json?
  createdAt    DateTime   @default(now())

  @@schema("jobs_service")
}