PORT=8003
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DBNAME
REDIS_URL=redis://localhost:6379
INTERNAL_API_KEY=change-me

# embeddings: "minilm" = real model; "hash" = offline stand-in for tests/CI ONLY (never in production)
EMBEDDING_BACKEND=minilm
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# scorer (SCORER_PATH unset = app/artifacts/scorer.json; the serving bar is ELIGIBILITY_THRESHOLD in the verdict block below)
# SCORER_PATH=
MIN_REQUIRED_SKILL_COVERAGE=0.35
EXPERIENCE_GATE_RATIO=0.5
EXPERIENCE_GATE_MIN_GAP_YEARS=1

# role level: interim nudges for fresher/any roles, used only while scorer.json has no fresher features (0 = off)
FRESHER_PROJECT_WEIGHT=0.6
FRESHER_INTERNSHIP_WEIGHT=0.3

# retrieval + efficiency (contract section 8)
TOP_K_ROLES_PER_RESUME=50
TOP_K_RESUMES_PER_ROLE=100
BATCH_SIZE=25
EARLY_STOP_EMPTY_BATCHES=2
MAX_ELIGIBLE_PER_ROLE=200
SIDE_CACHE_SIZE=2000
# prefilter is OFF while this is unset. Enable only after the gold set shows recall drops by no more than 1 point.
# PREFILTER_MIN_COSINE=0.2

# what is published
MAX_INELIGIBLE_PER_RESUME=5
MAX_INELIGIBLE_PER_ROLE=5
MIN_PUBLISH_SCORE=0.20

# ops
LOG_LEVEL=INFO
ENABLE_DOCS=false
ENABLE_MATCHING_CONSUMER=true

ELIGIBILITY_THRESHOLD=0.40
FRESHER_ELIGIBILITY_THRESHOLD=0.40
REVIEW_BAND_WIDTH=0.10
MAX_REVIEW_PER_RESUME=20
MAX_REVIEW_PER_ROLE=20
OVERQUALIFIED_EXTRA_YEARS=5

# production: the agent refuses to start with EMBEDDING_BACKEND=hash and without a valid app/artifacts/scorer.json
# APP_ENV=production
# (training only: GROQ_API_KEY is read by training/llm_client.py from your shell, not from this file)