generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas = ["matches_service"]
}

model Match {
  id          String   @id @default(uuid())
  applicantId String
  jobRoleId   String
  score       Float
  eligible    Boolean
  feedback    String?
  createdAt   DateTime @default(now())

  @@schema("matches_service")
}