generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas = ["matches_service"]
}

model Match {
  id            String   @id @default(uuid())
  applicantId   String
  jobRoleId     String
  roleTitle     String?
  resumeId      String?
  score         Float
  eligible      Boolean
  reason        String?
  matchedSkills String[] @default([])
  partialSkills String[] @default([])
  missingSkills String[] @default([])
  breakdown     Json?
  modelVersion  String?
  feedback      String?
  // consent flow: the company sees a match ONLY after the applicant approved it
  applicantStatus String  @default("pending") // 'pending' | 'approved' | 'declined'
  approvedAt    DateTime?
  resumeStatus  String   @default("none")      // after approval: 'none' (preparing) | 'ready' (PDF sent) | 'failed'
  resumeSharedAt DateTime?
  decision      String?   // recruiter verdict: 'shortlisted' | 'rejected' (null = undecided) -> real training labels
  decidedAt     DateTime?
  decidedBy     String?
  // shortlist / reject flows + coach agent output (contract §4.7)
  shortlistInfo     Json?     // company details sent to the applicant when shortlisted
  rejectReason      String?   // recruiter's category: NEVER shown to the applicant
  rejectMessage     String?   // optional recruiter note
  prepGuide         String?   // feedback-agent: interview prep guide after shortlist
  rejectionFeedback String?   // feedback-agent: feedback after rejection (null for position_filled / other)
  // academic rules that could not be checked because the data was missing (names among cgpa, branch, passingYear, backlogs)
  unverifiedRules   String[]  @default([])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  // one row per (applicant, role): re-matching updates it instead of piling up duplicates
  @@unique([applicantId, jobRoleId])
  @@index([jobRoleId, eligible, applicantStatus, score])
  @@schema("matches_service")
}

// One row per (role, resume) the matching-agent EVALUATED, eligible or not (contract §4.7). Source of the
// "scanned / matched" numbers on the company and admin dashboards (Match only holds the pairs worth showing to
// people). Dashboard numbers count DISTINCT applicants: a person with two resumes is still one person.
model RoleScan {
  id          String   @id @default(uuid())
  jobRoleId   String
  applicantId String
  resumeId    String
  eligible    Boolean
  score       Float
  inputHash   String?  // sha1 of everything that influenced the score (contract §4.12), lets matching-agent skip unchanged pairs
  scannedAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@unique([jobRoleId, resumeId])
  @@index([jobRoleId, eligible])
  @@index([jobRoleId, applicantId])
  @@schema("matches_service")
}
