PORT=3006
NODE_ENV=development
DATABASE_URL=postgresql://user:password@localhost:5432/career_matching
REDIS_URL=redis://localhost:6379

# Same value in every service
JWT_SECRET=change-me-same-value-in-every-service
INTERNAL_API_KEY=change-me-same-value-in-every-service

# auth-service: GET /internal/users/:id/email (sent with x-internal-key). Unreachable = the e-mail job is retried.
AUTH_SERVICE_URL=http://localhost:3001
# Base URL used for the links inside e-mails (the web app, or nginx in front of it)
WEB_URL=http://localhost:3000

# E-mail: gmail (local dev, Gmail app password) | resend (production)
EMAIL_PROVIDER=gmail
GMAIL_USER=your-address@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password
GMAIL_FROM_NAME=Career Match
# RESEND_API_KEY=re_your_key
# EMAIL_FROM=Career Match <noreply@your-verified-domain.com>
# Dev safety net: mail ALWAYS goes to the real recipient first. Only if sending to that address fails (refused / invalid),
# it is sent to this inbox instead (subject says "[failed for: <recipient>]"). Leave unset in production.
# EMAIL_DEV_REDIRECT_TO=you@example.com

# Daily clean-up of expired notifications (retention: 90 days)
CLEANUP_ENABLED=true
CLEANUP_INTERVAL_HOURS=24
CLEANUP_BATCH_SIZE=1000

# ops
ENABLE_DOCS=false
LOG_LEVEL=info

# only read by `pnpm db:reset` (it refuses to run with NODE_ENV=production unless ALLOW_DB_RESET=true)
# ALLOW_DB_RESET=false