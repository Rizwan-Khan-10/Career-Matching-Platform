PORT=3003
DATABASE_URL=postgresql://user:password@localhost:5432/career_matching
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-same-value-in-every-service

# ops
LOG_LEVEL=info
ENABLE_DOCS=false

CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Storage cleanup (all optional)
UNCONFIRMED_RESUME_TTL_DAYS=14
CLEANUP_ENABLED=true
CLEANUP_INTERVAL_HOURS=24
CLEANUP_BATCH_SIZE=100
# user-service (admin opening a resume is written to the audit log there)
USER_SERVICE_URL=http://localhost:3002
INTERNAL_API_KEY=change-me

# browsers allowed to call this API (comma separated). Empty = any origin (local development only)
WEB_URL=http://localhost:3000
