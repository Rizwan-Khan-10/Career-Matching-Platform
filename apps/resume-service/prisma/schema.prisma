generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas = ["resumes_service"]
}

model Resume {
  id                 String   @id @default(uuid())
  applicantId        String
  cloudinaryPublicId String
  fileUrl            String
  pdfPublicId        String?   // PDF version used when the applicant approves sharing (set by resume-parser-agent)
  status             String   @default("pending")
  parsedData         Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@schema("resumes_service")
}