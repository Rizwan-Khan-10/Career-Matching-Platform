PORT=3002
NODE_ENV=development
DATABASE_URL=postgresql://user:password@localhost:5432/career_matching
REDIS_URL=redis://localhost:6379

# Same value in every service
JWT_SECRET=change-me-same-value-in-every-service
INTERNAL_API_KEY=change-me-same-value-in-every-service

# Cloudinary (avatars)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ops
ENABLE_DOCS=false
LOG_LEVEL=info

# only read by `pnpm db:reset` (it refuses to run with NODE_ENV=production unless ALLOW_DB_RESET=true)
# ALLOW_DB_RESET=false