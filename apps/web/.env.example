# Base URL of nginx: every REST call goes here (nginx listens on port 80 locally)
NEXT_PUBLIC_API_URL=http://localhost

# socket.io: the nginx URL above, or the websocket-gateway directly
NEXT_PUBLIC_WS_URL=http://localhost:3007

# TEMPORARY: true = fake responses for endpoints whose backend is not merged yet (see README, "Mocks")
NEXT_PUBLIC_USE_MOCKS=false