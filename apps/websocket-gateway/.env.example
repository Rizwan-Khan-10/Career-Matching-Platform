PORT=3007
NODE_ENV=development
REDIS_URL=redis://localhost:6379

# Same value in every service: tokens are verified with it when a socket connects
JWT_SECRET=change-me-same-value-in-every-service

# Origin(s) of the web app that may open a socket from a browser (CORS). One URL, or several separated by commas.
# Use the address shown in the browser bar: http://localhost:3000 for `next dev`, or the nginx URL (http://localhost) in Docker.
WEB_URL=http://localhost:3000

# ops
ENABLE_DOCS=false
LOG_LEVEL=info