# Everything goes through nginx, like the browser does
E2E_BASE_URL=http://localhost

# The admin created by `pnpm seed` (same values as the auth-service .env)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Invite / reset tokens are only e-mailed, so the suite reads them from Redis (key "reset:<token>")
E2E_REDIS_URL=redis://localhost:6379

# Checkpoint 11 reads matching-agent /stats (needs the internal key). Skipped when the key is empty.
E2E_MATCHING_AGENT_URL=http://localhost:8003
E2E_INTERNAL_API_KEY=

# Optional timing: how long to wait for an async step, and before asserting that something did NOT happen
E2E_WAIT_MS=120000
E2E_QUIET_MS=10000

# Only if the admin account has two-factor on: the base32 key shown under the QR code
# E2E_ADMIN_TOTP_SECRET=